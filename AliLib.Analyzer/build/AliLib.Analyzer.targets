<Project>
  <Target Name="PostBuildCopy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPath)" />
  </Target>

  <Target Name="NormalizeModPath" BeforeTargets="BeforeBuild">
	<PropertyGroup>
	  <ModPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ModPath)'))</ModPath>
	</PropertyGroup>
  </Target>


 <!-- TODO: Do we need this? -->
  <ItemGroup>
	<CompilerVisibleProperty Include="ModPath" />
  </ItemGroup>
</Project>