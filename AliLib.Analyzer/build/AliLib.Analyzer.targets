<Project>
	<PropertyGroup>
		<AliLibLinkage Condition="'$(AliLibLinkage)' == ''">dynamic</AliLibLinkage>
	</PropertyGroup>
	
  <Target Name="PostBuildCopy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPath)" />

	  <Copy
		SourceFiles="@(ReferenceCopyLocalPaths->'%(FullPath)')"
		DestinationFolder="$(ModPath)"
		Condition="'$(AliLibLinkage)' == 'dynamic' AND '%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'AliLib.Core.dll'" />
  </Target>

  <Target Name="NormalizeModPath" BeforeTargets="BeforeBuild">
	<PropertyGroup>
	  <ModPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ModPath)'))</ModPath>
	</PropertyGroup>
  </Target>


 <!-- TODO: Do we need this? -->
  <ItemGroup>
	<CompilerVisibleProperty Include="ModPath" />
  </ItemGroup>
</Project>