<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
  </PropertyGroup>

	<!-- Custom AliLib Properties -->
	<PropertyGroup>
		<ModName>AliLibTest</ModName>
	</PropertyGroup>

	<Target Name="PostBuildCopy" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\Mods\AliLibTest" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\AliLib.Analyzer\AliLib.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\AliLib.Core\AliLib.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ThunderRoad">
			<HintPath>..\..\..\Managed\ThunderRoad.dll</HintPath>
		</Reference>

		<Reference Include="UnityEngine">
			<HintPath>..\..\..\Managed\UnityEngine.dll</HintPath>
		</Reference>

		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\..\..\Managed\UnityEngine.CoreModule.dll</HintPath>
		</Reference>

			<Reference Include="UnityEngine.AudioModule">
				<HintPath>..\..\..\Managed\UnityEngine.AudioModule.dll</HintPath>
			</Reference>
	</ItemGroup>
</Project>